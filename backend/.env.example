# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fire_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fire_intelligence
# Async DB URL (optional if using async SQLAlchemy)
ASYNC_DATABASE_URL=postgresql+psycopg_async://postgres:postgres@localhost:5432/fire_intelligence

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:8443","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:8443"]

# Dataset Ingestion Paths (Relative to workspace root or absolute)
DATASET_BRAZIL_PATH=./brazil
DATASET_CANADA_PATH=./canada

# DuckDB Analytics Cache Path
DUCKDB_PATH=./data/analytics.duckdb
PARQUET_STORE_PATH=./data/parquet

# Weather Integration (NASA POWER / Open-Meteo)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
